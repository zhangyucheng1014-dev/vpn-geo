[Unit]
Description=VPN node priority manager

[Service]
Type=simple
ExecStart=%h/.local/bin/vpn-geo daemon
Restart=on-failure
RestartSec=5s
Nice=10
CPUWeight=20
IOWeight=20
MemoryHigh=64M
MemoryMax=128M
TasksMax=32
Environment=GOMEMLIMIT=64MiB GODEBUG=madvdontneed=1
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target

[Unit]
Description=VPN node priority manager
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/vpn-geo daemon
Restart=on-failure
RestartSec=5s
# The watcher is event-driven; keep it out of latency-sensitive user work.
Nice=10
CPUWeight=20
IOWeight=20
# Bound transient work and let the Go runtime scavenge unused heap pages.
MemoryHigh=64M
MemoryMax=128M
TasksMax=32
Environment=GOMEMLIMIT=64MiB GODEBUG=madvdontneed=1
# The service only needs NetworkManager's D-Bus API and outbound HTTP.
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
